# ===== WeKnora 部署配置（本机最小栈）=====
# 生成时间: 2026-09-15 00:55:11

# ---- 对外端口（80/443 被宿主 nginx 占用，8080 被其他 python 服务占用，故改用下列端口）----
FRONTEND_PORT=8081
APP_PORT=8083

# ---- 数据库（容器内 ParadeDB/pg17，兼作向量库）----
DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_USER=weknora
DB_PASSWORD=请填写你自己的值
DB_NAME=weknora
AUTO_MIGRATE=true

# ---- Redis ----
REDIS_ADDR=redis:6379
REDIS_PASSWORD=请填写你自己的值
REDIS_DB=0

# ---- 检索与存储：全部走容器内 postgres + 本地磁盘，不引入额外中间件 ----
RETRIEVE_DRIVER=postgres
STORAGE_TYPE=local
LOCAL_STORAGE_BASE_DIR=/data/files

# ---- 文档解析 ----
DOCREADER_ADDR=docreader:50051
DOCREADER_TRANSPORT=grpc
# 4 核机器，收敛并行度避免内存峰值打满
DOCREADER_GRPC_MAX_WORKERS=2
DOCREADER_PDF_RENDER_MAX_WORKERS=1
DOCREADER_MARKITDOWN_MAX_WORKERS=1
MAX_FILE_SIZE_MB=50

# ---- 并发：按 4 核 / 3.6G 内存下调（官方默认偏高）----
CONCURRENCY_POOL_SIZE=3
WEKNORA_ASYNQ_CORE_CONCURRENCY=3
WEKNORA_ASYNQ_POSTPROCESS_CONCURRENCY=1
WEKNORA_ASYNQ_ENRICHMENT_CONCURRENCY=3
WEKNORA_ASYNQ_MAINTENANCE_CONCURRENCY=2
WEKNORA_ASYNQ_SHARED_CONCURRENCY=2
WEKNORA_WIKI_ASYNQ_CONCURRENCY=2
WEKNORA_MODEL_MAX_CONCURRENCY=8

# ---- 安全密钥（SYSTEM_AES_KEY 丢失则库内所有加密字段无法解密，务必备份）----
JWT_SECRET=请填写你自己的值
SYSTEM_AES_KEY=83cb84e3fe1928dab9e560226d2a0348

# ---- 运行时 ----
GIN_MODE=release
LOG_LEVEL=info
TZ=Asia/Shanghai
WEKNORA_LANGUAGE=zh-CN
# 无 GPU，不启本地 Ollama；设为可选避免启动阻塞
OLLAMA_OPTIONAL=true
# Docker 沙箱等同宿主 root 权限，保持关闭
WEKNORA_SANDBOX_DOCKER_ENABLED=false

# ---- 模型服务：阿里百炼（DashScope，OpenAI 兼容端点）----
# 在 Web 界面「模型配置」中填入下列信息即可，本节仅作记录备查：
#   Base URL : https://dashscope.aliyuncs.com/compatible-mode/v1
#   对话模型 : qwen-plus（或 qwen-max / qwen-turbo）
#   向量模型 : text-embedding-v4
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=请填写你自己的值
